{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["electron.vite.config.ts", "vite.components.config.ts", "playwright.config.ts", "playwright.gui.config.ts", "src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts", "src/domain/**/*.ts", "src/adapters/**/*.ts", "src/renderer/src/env.d.ts", "tests/**/*.ts"]
}
