{
  "name": "workday-escape-poc",
  "version": "2.0.0",
  "description": "Workday Escape V2.0 stage 1 desktop feasibility POC",
  "author": "Workday Escape",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "npm run build && install-electron && electron-builder --win portable --x64 --publish never",
    "test": "node scripts/test-logic.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "test:dates": "node scripts/test-dates.mjs",
    "test:calendar": "node scripts/test-calendar.mjs",
    "test:business": "node scripts/test-business.mjs",
    "test:shifts": "node scripts/test-shifts.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "test:lifecycle": "node scripts/test-lifecycle.mjs",
    "test:d09": "node scripts/test-d09.mjs",
    "test:d11": "node scripts/test-d11.mjs",
    "test:d11:visual": "npm run build && node scripts/test-d11-visual.mjs",
    "test:d11:services": "node scripts/test-d11-services.mjs",
    "test:d12": "node scripts/test-d12.mjs",
    "test:d13": "node scripts/test-d13.mjs",
    "test:d12:visual": "npm run build && node scripts/test-d11-visual.mjs --d12",
    "profile:d11": "node scripts/test-lifecycle.mjs d11-performance",
    "test:d10": "node scripts/test-d10.mjs",
    "test:d10:visual": "node scripts/test-d10-visual.mjs",
    "preview:components": "vite --config vite.components.config.ts",
    "build:components": "vite build --config vite.components.config.ts",
    "test:unit": "node scripts/test-unit.mjs",
    "test:desktop": "npm run build && playwright test",
    "test:desktop:gui": "npm run build && playwright test --config=playwright.gui.config.ts",
    "package:win:test": "npm run build && node scripts/build-portable-test.mjs",
    "verify:portable": "node scripts/verify-portable.mjs",
    "verify:lifecycle:portable": "node scripts/verify-lifecycle-portable.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.4",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue": "3.5.43",
    "vue-tsc": "3.3.13"
  }
}
